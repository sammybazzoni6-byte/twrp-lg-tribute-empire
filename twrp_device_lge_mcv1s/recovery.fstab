# mount point   fstype   device                                                                   [device2]  flags
/boot           emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot
/recovery       emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery
/misc           emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para
/system         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system             flags=display="System";backup=1
/vendor         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vendor             flags=display="Vendor";backup=1
/cache          ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache
/data           ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata
/nvram          emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram              flags=backup=1;display="NVRAM"
/proinfo        emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo            flags=backup=1;display="Proinfo"
/nvdata         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata             flags=backup=1;display="NVData"
/nvcfg          ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvcfg              flags=backup=1;display="NVCfg"
/persist        ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/persist            flags=backup=1;display="Persist"
/external_sd    auto     /dev/block/mmcblk1p1             /dev/block/mmcblk1                      flags=display="Micro SD";storage;wipeingui;removable
/usb_otg        auto     /dev/block/sda1                  /dev/block/sda                          flags=display="USB OTG";storage;wipeingui;removable
